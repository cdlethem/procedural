{
  "id": "cp10-spring-response",
  "status": "completed",
  "owner": "root",
  "question": "Do spring strength and retained velocity each provide a distinct useful control over a reproducible target-driven motion?",
  "decision": "retain-and-bound | retain-unbounded | internalize | reject",
  "hypothesis": "With identical target disturbance, changing spring strength changes response timing and changing retained velocity changes persistence/overshoot; both must be demonstrated rather than labelled organic drift.",
  "source_sketches": [
    "2018/Generativos/araniaaas"
  ],
  "parameter": {
    "name": "spring strength and velocity retention investigated separately",
    "default": null,
    "unit": "per explicit logical update; no seconds conversion"
  },
  "baseline": {
    "path": ".work/parameter-experiments/cp10-spring-response/baseline",
    "kind": "planned source-extracted investigation harness, not historical survey baseline",
    "deterministic": true,
    "renderer": "JAVA2D",
    "canvas": [
      640,
      640
    ],
    "pixel_density": 1,
    "spring": 0.025,
    "velocity_retention": 0.7,
    "return_lerp": 0.04,
    "policy": "Explicit authored values; no public default or recommended range claim."
  },
  "values": [
    {
      "id": "spring-zero",
      "spring": 0,
      "velocity_retention": 0.7
    },
