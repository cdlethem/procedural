import java.util.*;
import java.nio.ByteBuffer;
import java.security.MessageDigest;
import processing.core.PApplet;
import processing.awt.PGraphicsJava2D;
import org.procedurals.color.CyclicPalette;
import org.procedurals.processing.internal.Java2DFrame;

/** Registered CP1 command-route integration; not upstream pixel reproduction. */
public final class Java2DFieldMarks {
    static Map<String,Object> map(Object... pairs) {
        Map<String,Object> result=new LinkedHashMap<>();
        for(int i=0;i<pairs.length;i+=2) result.put((String)pairs[i],pairs[i+1]);
        return result;
    }
    static List<Double> point(double x,double y) { return Arrays.asList(x,y); }
    static String hex(byte[] bytes) {
        StringBuilder out=new StringBuilder();
        for(byte value:bytes) out.append(String.format("%02x",value&255));
        return out.toString();
    }
    static String modelHash(MarkField m) throws Exception {
        MessageDigest hash=MessageDigest.getInstance("SHA-256");
        ByteBuffer b=ByteBuffer.allocate(40);
        for(int i=0;i<m.x.length;i++) {
            b.clear(); b.putDouble(m.x[i]).putDouble(m.y[i]).putDouble(m.heading[i])
                .putDouble(m.lengthFactor[i]).putDouble(m.colourCycles[i]); hash.update(b.array());
        }
        return hex(hash.digest());
    }
    static final MarkField marks=MarkField.create(42,160,160,4);
    static void render(String id,double maxLength,Integer[] colors,boolean bars,String output) throws Exception {
        String before=modelHash(marks);
        CyclicPalette palette=CyclicPalette.create(Collections.singletonMap("colors",Arrays.asList(colors)));
        Java2DFrame frame=new Java2DFrame(new PApplet());
        frame.begin(map("width",640,"height",640,"density",1,"background",0xece7da));
        MessageDigest geometry=MessageDigest.getInstance("SHA-256"), color=MessageDigest.getInstance("SHA-256");
        ByteBuffer bits=ByteBuffer.allocate(4);
        List<Object> batch=new ArrayList<>();
        int omitted=0;
        try {
            for(int i=0;i<marks.x.length;i++) {
                double x=marks.x[i],y=marks.y[i],cos=Math.cos(marks.heading[i]),sin=Math.sin(marks.heading[i]);
                double length=maxLength*marks.lengthFactor[i],dx=.5*length*cos,dy=.5*length*sin;
                if(length==0) { omitted++;continue; }
                int rgb=palette.sample(marks.colourCycles[i]);
                List<List<Double>> points;
                Map<String,Object> command;
                if(bars) {
                    double nx=-sin*1.25,ny=cos*1.25;
                    points=Arrays.asList(point(x-dx-nx,y-dy-ny),point(x+dx-nx,y+dy-ny),
                        point(x+dx+nx,y+dy+ny),point(x-dx+nx,y-dy+ny));
                    command=map("kind","quad2","vertices",points,"rgb",rgb,"opacity8",180);
                } else {
                    points=Arrays.asList(point(x-dx,y-dy),point(x+dx,y+dy));
                    command=map("kind","segment2","from",points.get(0),"to",points.get(1),
                        "rgb",rgb,"opacity8",180,"width",1,"cap","round");
                }
                for(List<Double> p:points) for(double value:p) {
                    bits.clear();bits.putFloat((float)value);geometry.update(bits.array());
                }
                bits.clear();bits.putInt((180<<24)|rgb);color.update(bits.array());
                batch.add(command);
                if(batch.size()==4096) { frame.batch(batch);batch.clear(); }
            }
            frame.batch(batch);
            if(frame.count()!=marks.x.length-omitted || !before.equals(modelHash(marks)))
                throw new AssertionError("Count or retained field changed");
            PGraphicsJava2D image=frame.end();
            try { if(!image.save(output)) throw new AssertionError("Image save failed"); }
            finally { Java2DFrame.releaseCompleted(image); }
        } finally { if(!frame.state().equals("completed"))frame.abort(); }
        System.out.println("{\"id\":\""+id+"\",\"model_sha256\":\""+before+
            "\",\"geometry_sha256\":\""+hex(geometry.digest())+"\",\"color_sha256\":\""+
            hex(color.digest())+"\",\"commands\":"+frame.count()+",\"omitted_zero_length\":"+omitted+"}");
    }
    public static void main(String[] args) throws Exception {
        /* REGISTERED_RENDER_CALLS */
    }
}
