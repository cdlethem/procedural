{
  "name": "@procedurals/javascript",
  "version": "0.2.1",
  "type": "module",
  "types": "./types/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/src/index.d.ts",
      "default": "./src/index.js"
    },
    "./examples/*.js": {
