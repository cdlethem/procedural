{
  "name": "@procedurals/instruments",
  "version": "0.2.3",
  "description": "Library-owned p5.js instrument constructions and teaching studies",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@procedurals/javascript": "0.2.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal/cut-model": {
      "types": "./dist/cut-model.d.ts",
      "default": "./dist/cut-model.js"
    },
    "./internal/*": {
      "types": "./dist/adapters/*.d.ts",
      "default": "./dist/adapters/*.js"
    },
    "./metadata.json": "./metadata.json",
    "./manifest.json": "./manifest.json",
    "./sources.json": "./sources.json",
    "./guides/*": "./guides/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "src/",
    "assets/",
    "guides/",
    "tools/",
    "tsconfig.json",
    "metadata.json",
    "manifest.json",
    "sources.json",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "sources": "node tools/generate_sources.mjs",
    "test": "python3 ../../tools/with_heavy_lock.py -- tsx --test --test-concurrency=4 tests/*.test.ts"
  },
  "devDependencies": {
    "@babel/parser": "8.0.4",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
