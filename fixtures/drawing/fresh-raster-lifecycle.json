{
  "profile": "drawing.fresh-raster-2d",
  "version": "0.1.0",
  "status": "authored state-model scenarios; not executed native lifecycle conformance",
  "environment": {
    "width": 640,
    "height": 640,
    "density": 1,
    "background": 0
  },
  "harness_rules": {
    "repeat": "Expand only in test harness; not public batch/recipe syntax.",
    "faults": "Injected model events; actual native failure validation is separate.",
    "test_hook_initial_active_count": "Test-only active-state count initialization for exact integer boundary; never a public way to resume/forge a frame.",
    "ownership_expectations": "Acquire after static preflight. Successful acquisition increments acquisition count; any failure thereafter or active abort releases exactly once. Successful end transfers ownership without release; integration release after that is outside model. Repeated abort must not double release. No native command attempts occur on invalid batches."
  },
  "cases": [
    {
      "id": "empty-frame-terminal",
      "steps": [
        {
          "action": "begin",
          "expected": {
            "state": "active",
            "error": null
          }
        },
        {
          "action": "batch",
          "commands": [],
          "expected": {
            "state": "active",
            "error": null
          }
        },
        {
          "action": "end",
          "expected": {
            "state": "completed",
            "error": null
          }
        },
        {
          "action": "end",
          "expected": {
            "state": "completed",
            "error": {
              "code": "INVALID_STATE",
              "commandIndex": null
            }
          }
        },
        {
          "action": "batch",
          "commands": [],
          "expected": {
            "state": "completed",
            "error": {
              "code": "INVALID_STATE",
              "commandIndex": null
            }
          }
        },
        {
          "action": "begin",
          "expected": {
            "state": "completed",
            "error": {
              "code": "INVALID_STATE",
              "commandIndex": null
            }
          }
        },
        {
          "action": "abort",
          "expected": {
            "state": "completed",
            "error": {
              "code": "INVALID_STATE",
              "commandIndex": null
            }
          }
        }
      ],
      "expected_final_events": {
        "acquired": 1,
        "released": 0,
        "transferred": 1,
        "native_command_attempts": 0
      }
    },
